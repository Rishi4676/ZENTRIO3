{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": ".",
  "functions": {
    "api/index.js": {
      "includeFiles": [
        "apps/website/**",
        "database/backups/**"
      ]
    }
  },
  "rewrites": [
    {
      "source": "/",
      "destination": "/apps/website/index.html"
    },
    {
      "source": "/background-video.mp4",
      "destination": "/apps/website/public/videos/background-video.mp4"
    },
    {
      "source": "/background%20video.mp4",
      "destination": "/apps/website/public/videos/background-video.mp4"
    },
    {
      "source": "/LOGOO.png",
      "destination": "/apps/website/assets/images/LOGOO.png"
    },
    {
      "source": "/logo.png",
      "destination": "/apps/website/assets/images/LOGOO.png"
    },
    {
      "source": "/LOGO.png",
      "destination": "/apps/website/assets/images/LOGOO.png"
    },
    {
      "source": "/syed.jpg",
      "destination": "/apps/website/assets/syed.jpg"
    },
    {
      "source": "/rishi.png",
      "destination": "/apps/website/assets/rishi.png"
    },
    {
      "source": "/mobile_app.jpg",
      "destination": "/apps/website/assets/mobile_app.jpg"
    },
    {
      "source": "/css/(.*)",
      "destination": "/apps/website/css/$1"
    },
    {
      "source": "/js/(.*)",
      "destination": "/apps/website/js/$1"
    },
    {
      "source": "/assets/(.*)",
      "destination": "/apps/website/assets/$1"
    },
    {
      "source": "/publicity/(.*)",
      "destination": "/apps/website/publicity/$1"
    },
    {
      "source": "/videos/(.*)",
      "destination": "/apps/website/public/videos/$1"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/index.js"
    },
    {
      "source": "/robots.txt",
      "destination": "/api/index.js"
    },
    {
      "source": "/admin/payments",
      "destination": "/api/index.js"
    },
    {
      "source": "/admin/revenue",
      "destination": "/api/index.js"
    },
    {
      "source": "/admin/refunds",
      "destination": "/api/index.js"
    },
    {
      "source": "/admin/subscriptions",
      "destination": "/api/index.js"
    },
    {
      "source": "/admin/background-video.mp4",
      "destination": "/apps/website/public/videos/background-video.mp4"
    },
    {
      "source": "/admin/background%20video.mp4",
      "destination": "/apps/website/public/videos/background-video.mp4"
    },
    {
      "source": "/admin/videos/(.*)",
      "destination": "/apps/website/public/videos/$1"
    },
    {
      "source": "/admin/LOGOO.png",
      "destination": "/apps/website/assets/images/LOGOO.png"
    },
    {
      "source": "/admin/logo.png",
      "destination": "/apps/website/assets/images/LOGOO.png"
    },
    {
      "source": "/admin/syed.jpg",
      "destination": "/apps/website/assets/syed.jpg"
    },
    {
      "source": "/admin/rishi.png",
      "destination": "/apps/website/assets/rishi.png"
    },
    {
      "source": "/admin/assets/(.*)",
      "destination": "/apps/admin/dist/assets/$1"
    },
    {
      "source": "/admin/favicon.svg",
      "destination": "/apps/admin/dist/favicon.svg"
    },
    {
      "source": "/admin/icons.svg",
      "destination": "/apps/admin/dist/icons.svg"
    },
    {
      "source": "/admin(.*)",
      "destination": "/apps/admin/dist/index.html"
    },
    {
      "source": "/portal/background-video.mp4",
      "destination": "/apps/website/public/videos/background-video.mp4"
    },
    {
      "source": "/portal/background%20video.mp4",
      "destination": "/apps/website/public/videos/background-video.mp4"
    },
    {
      "source": "/portal/videos/(.*)",
      "destination": "/apps/website/public/videos/$1"
    },
    {
      "source": "/portal/LOGOO.png",
      "destination": "/apps/website/assets/images/LOGOO.png"
    },
    {
      "source": "/portal/logo.png",
      "destination": "/apps/website/assets/images/LOGOO.png"
    },
    {
      "source": "/portal/syed.jpg",
      "destination": "/apps/website/assets/syed.jpg"
    },
    {
      "source": "/portal/rishi.png",
      "destination": "/apps/website/assets/rishi.png"
    },
    {
      "source": "/portal/mobile_app.jpg",
      "destination": "/apps/website/assets/mobile_app.jpg"
    },
    {
      "source": "/portal/assets/(.*)",
      "destination": "/apps/portal/dist/assets/$1"
    },
    {
      "source": "/portal/favicon.svg",
      "destination": "/apps/portal/dist/favicon.svg"
    },
    {
      "source": "/portal/icons.svg",
      "destination": "/apps/portal/dist/icons.svg"
    },
    {
      "source": "/portal(.*)",
      "destination": "/apps/portal/dist/index.html"
    },
    {
      "source": "/login",
      "destination": "/apps/portal/dist/index.html"
    },
    {
      "source": "/signup",
      "destination": "/apps/portal/dist/index.html"
    },
    {
      "source": "/projects",
      "destination": "/apps/website/pages/project.html"
    },
    {
      "source": "/feedback",
      "destination": "/apps/website/pages/feedback.html"
    },
    {
      "source": "/pricing",
      "destination": "/apps/website/pages/pricing.html"
    },
    {
      "source": "/contact",
      "destination": "/apps/website/pages/contact.html"
    },
    {
      "source": "/preview-bg",
      "destination": "/apps/website/pages/preview-bg.html"
    },
    {
      "source": "/privacy-policy",
      "destination": "/apps/website/pages/privacy-policy.html"
    },
    {
      "source": "/refund-policy",
      "destination": "/apps/website/pages/refund-policy.html"
    },
    {
      "source": "/terms-of-service",
      "destination": "/apps/website/pages/terms-of-service.html"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    }
  ]
}
