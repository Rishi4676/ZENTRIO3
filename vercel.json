{
  "version": 2,
  "buildCommand": "npm run build",
  "functions": {
    "api/index.js": {
      "includeFiles": "audit_logs.json",
      "excludeFiles": "{admin0/**,portal-login/**}"
    }
  },
  "rewrites": [
    {
      "source": "/admin/payments",
      "destination": "/api/index.js"
    },
    {
      "source": "/admin/revenue",
      "destination": "/api/index.js"
    },
    {
      "source": "/admin/refunds",
      "destination": "/api/index.js"
    },
    {
      "source": "/admin/subscriptions",
      "destination": "/api/index.js"
    },
    {
      "source": "/admin/assets/(.*)",
      "destination": "/admin0/dist/assets/$1"
    },
    {
      "source": "/admin/favicon.svg",
      "destination": "/admin0/dist/favicon.svg"
    },
    {
      "source": "/admin/icons.svg",
      "destination": "/admin0/dist/icons.svg"
    },
    {
      "source": "/admin(.*)",
      "destination": "/admin0/dist/index.html"
    },
    {
      "source": "/portal/assets/(.*)",
      "destination": "/portal-login/dist/assets/$1"
    },
    {
      "source": "/portal/favicon.svg",
      "destination": "/portal-login/dist/favicon.svg"
    },
    {
      "source": "/portal/icons.svg",
      "destination": "/portal-login/dist/icons.svg"
    },
    {
      "source": "/portal(.*)",
      "destination": "/portal-login/dist/index.html"
    },
    {
      "source": "/login",
      "destination": "/portal-login/dist/index.html"
    },
    {
      "source": "/signup",
      "destination": "/portal-login/dist/index.html"
    },
    {
      "source": "/projects",
      "destination": "/project.html"
    },
    {
      "source": "/feedback",
      "destination": "/feedback.html"
    },
    {
      "source": "/pricing",
      "destination": "/pricing.html"
    },
    {
      "source": "/contact",
      "destination": "/contact.html"
    },
    {
      "source": "/privacy-policy",
      "destination": "/privacy-policy.html"
    },
    {
      "source": "/refund-policy",
      "destination": "/refund-policy.html"
    },
    {
      "source": "/terms-of-service",
      "destination": "/terms-of-service.html"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    }
  ]
}
