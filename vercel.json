{
  "version": 2,
  "buildCommand": "cd admin0 && npm install --include=dev && npm run build && cd ../portal-login && npm install --include=dev && npm run build",
  "functions": {
    "api/index.js": {
      "excludeFiles": "{admin0/src/**,portal-login/src/**}"
    }
  },
  "rewrites": [
    {
      "source": "/admin/assets/(.*)",
      "destination": "/admin0/dist/assets/$1"
    },
    {
      "source": "/admin/favicon.svg",
      "destination": "/admin0/dist/favicon.svg"
    },
    {
      "source": "/admin/icons.svg",
      "destination": "/admin0/dist/icons.svg"
    },
    {
      "source": "/admin(.*)",
      "destination": "/admin0/dist/index.html"
    },
    {
      "source": "/portal/assets/(.*)",
      "destination": "/portal-login/dist/assets/$1"
    },
    {
      "source": "/portal/favicon.svg",
      "destination": "/portal-login/dist/favicon.svg"
    },
    {
      "source": "/portal(.*)",
      "destination": "/portal-login/dist/index.html"
    },
    {
      "source": "/login",
      "destination": "/portal-login/dist/index.html"
    },
    {
      "source": "/signup",
      "destination": "/portal-login/dist/index.html"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/((?!css|js|assets|LOGOO.png|rishi.png|syed.jpg).*)$",
      "destination": "/api/index.js"
    }
  ]
}
